# Kernel configuration of the a04br3 image. CONFIG_XNU_<NAME> becomes XNU_<NAME> for the kernel build.
# Starts from configs/sheng_defconfig of UniXNU-sheng without the Qualcomm board drivers (UFS, Adreno, PMGR, legacy display).
# MT8167 is a Cortex-A35 (ARMv8.0): no PAN, so NATIVE_PAN stays off.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y
CONFIG_XNU_NATIVE_RAM_BLOCK=y
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_SOURCE_MOCKFS=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/a04br3-board/libA04BR3Board.a"
CONFIG_XNU_NATIVE_PAN=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_ARMCPU_GICV2=y
CONFIG_XNU_NS16550_UART=y
CONFIG_XNU_BOARD_INIT=y
