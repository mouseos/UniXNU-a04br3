+/* Only caller-proven initialized ranges of a CPU-owned BO, at most 128 bytes. */
+static void pvr_darwin_sipf1_dump_range(UNUSED bool enabled, UNUSED const void *map,
+                                        UNUSED uint64_t va, UNUSED uint64_t total,
+                                        UNUSED uint64_t offset, UNUSED uint64_t meaningful,
+                                        UNUSED const char *label)
+{
+#ifdef PVR_WINSYS_DARWIN
+   if (!enabled || !map || !meaningful || offset >= total) return;
+   uint64_t length = meaningful < total - offset ? meaningful : total - offset;
+   if (length > 128) length = 128;
+   if (!pvr_darwin_sipf1_touch_only()) {
+      char text[256];
+      snprintf(text, sizeof(text), "pvr SIPF1 %s bo=%llx size=%llu offset=%llx initialized=%llu captured=%llu",
+               label, (unsigned long long)va, (unsigned long long)total,
+               (unsigned long long)offset, (unsigned long long)meaningful,
+               (unsigned long long)length);
+      const char *marker_only = getenv("PVR_DARWIN_SIPF1_MARKER_ONLY");
+      if (!marker_only || strcmp(marker_only, "1")) fprintf(stderr, "%s\n", text);
+      pvr_darwin_sipf1_log(text);
+   }
+   for (uint64_t i = 0; i < length; i += 16)
+      pvr_darwin_sipf1_dump_bytes(true, map, total, offset + i,
+                                  length - i < 16 ? length - i : 16, label);
+#endif
+}
+
+/* One-quad v1 layout: ISP16, index8, XYZ32, PDS28 + reserved4.
+ * Capture only initialized fields, never the trailing PDS padding/varyings.
+ */
+static void pvr_darwin_sipf1_dump_primitive(bool enabled, const void *map,
+                                           uint64_t total, uint64_t offset,
+                                           uint64_t emitted)
+{
+   if (!enabled || offset > total || emitted > total - offset || emitted < 84) return;
+   pvr_darwin_sipf1_dump_bytes(enabled, map, total, offset + 16, 8, "first-index");
+   pvr_darwin_sipf1_dump_bytes(enabled, map, total, offset + 24, 16, "first-vertex01");
+   pvr_darwin_sipf1_dump_bytes(enabled, map, total, offset + 40, 16, "first-vertex23");
+   pvr_darwin_sipf1_dump_bytes(enabled, map, total, offset + 56, 16, "first-pds-dw0-3");
+   pvr_darwin_sipf1_dump_bytes(enabled, map, total, offset + 72, 12, "first-pds-dw4-6");
+}
