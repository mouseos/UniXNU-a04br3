--- /dev/null
+++ b/src/imagination/vulkan/pvr_darwin_sipf1.h
@@ -0,0 +1,57 @@
+/* SPDX-License-Identifier: MIT
+ * MT8167 22.40.54.30 SIPF v1 transfer records. Derived from observed vendor
+ * libsrv_um.so d32a4a224d06302d9bec0a66cbb7d17dec663d3985f1c8592f5bb77353ca1d4b:
+ * primitive builder 0x12dc50, clip emitter 0x12934c. Not SIPF v2/legacy.
+ * Callers must opt in for this exact core. Pure checked encoders only.
+ */
+#ifndef PVR_DARWIN_SIPF1_H
+#define PVR_DARWIN_SIPF1_H
+#include <stdbool.h>
+#include <stdint.h>
+static inline bool pvr_sipf1_vertex_header(unsigned vertices, unsigned varying_bytes,
+                                           uint32_t *out)
+{
+   if (!out || vertices < 4 || vertices > 16 || vertices % 4 || varying_bytes > 511)
+      return false;
+   *out = ((vertices - 1U) << 5) | (varying_bytes << 10);
+   return true;
+}
+/* Primitive/link addresses are relative to the aligned 16 GiB hardware
+ * window, not necessarily the first allocatable address in that window.
+ */
+static inline bool pvr_sipf1_window_offset(uint64_t heap_base, uint64_t addr,
+                                           uint64_t *out)
+{
+   const uint64_t window_size = UINT64_C(1) << 34;
+   if (!out || heap_base >= (UINT64_C(1) << 40) || addr < heap_base ||
+       addr >= (UINT64_C(1) << 40)) return false;
+   const uint64_t window = heap_base & ~(window_size - 1U);
+   if (addr - window >= window_size) return false;
+   *out = addr - window;
+   return true;
+}
+static inline bool pvr_sipf1_address_valid(uint64_t addr)
+{
+   return !(addr & 7U) && addr < (UINT64_C(1) << 34);
+}
+static inline bool pvr_sipf1_primitive(uint64_t addr, unsigned quads, bool fill,
+                                       uint64_t *out)
+{
+   if (!out || !pvr_sipf1_address_valid(addr) || !quads || quads > 4 || (fill && quads != 1))
+      return false;
+   /* Complete two-triangle-per-quad mask. Vendor's normal clip batches and
+    * dedicated one-quad fill use distinct low headers; preserve both records.
+    */
+   uint64_t mask = ((UINT64_C(1) << (2U * quads)) - 1U) << 8;
+   uint32_t group = ((((quads * 16U + 24U) & 0xe0U) + 0xe0U) & 0xe0U);
+   uint64_t header = fill ? UINT64_C(0x100000028) : UINT64_C(0x100000008) | group;
+   *out = ((addr >> 3) << 33) | mask | header;
+   return true;
+}
+static inline bool pvr_sipf1_link(uint64_t addr, uint64_t *out)
+{
+   if (!out || !pvr_sipf1_address_valid(addr)) return false;
+   *out = ((addr >> 3) << 33) | UINT64_C(1);
+   return true;
+}
+#endif
