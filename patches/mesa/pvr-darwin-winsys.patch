+/* CPU-owned suballocation only: never translate or dereference a GPU VA. */
+static inline bool pvr_darwin_sipf1_touch_only(void)
+{
+#ifdef PVR_WINSYS_DARWIN
+   const char *dump = getenv("PVR_DARWIN_SIPF1_DUMP");
+   const char *touch = getenv("PVR_DARWIN_SIPF1_TOUCH");
+   return !(dump && strcmp(dump, "1") == 0) &&
+          touch && strcmp(touch, "1") == 0;
+#else
+   return false;
+#endif
+}
+
+static bool pvr_darwin_sipf1_dump_begin(UNUSED bool sipf1)
+{
+#ifdef PVR_WINSYS_DARWIN
+   static unsigned calls;
+   const char *env = getenv("PVR_DARWIN_SIPF1_DUMP");
+   if (!sipf1 || (!(env && strcmp(env, "1") == 0) &&
+                  !pvr_darwin_sipf1_touch_only())) return false;
+   unsigned n = __atomic_load_n(&calls, __ATOMIC_RELAXED);
+   /* Cover four mip clears and their four copies in one bounded capture. */
+   while (n < 8) {
+      if (__atomic_compare_exchange_n(&calls, &n, n + 1, false,
+                                      __ATOMIC_RELAXED, __ATOMIC_RELAXED)) return true;
+   }
+#endif
+   return false;
+}
+static void pvr_darwin_sipf1_dump_bytes(UNUSED bool enabled, UNUSED const void *map,
+                                       UNUSED uint64_t total, UNUSED uint64_t offset,
+                                       UNUSED uint64_t length, UNUSED const char *label)
+{
+#ifdef PVR_WINSYS_DARWIN
+   if (!enabled || !map || !length || length > 16 || offset > total || length > total - offset) return;
+   const uint8_t *bytes = (const uint8_t *)map + offset;
+   if (pvr_darwin_sipf1_touch_only()) {
+      const volatile uint8_t *touch = bytes;
+      uint8_t value = 0;
+      for (uint64_t i = 0; i < length; ++i)
+         value ^= touch[i];
+      volatile uint8_t consumed = value;
+      (void)consumed;
+      return;
+   }
+   static const char digits[] = "0123456789abcdef";
+   char hex[33];
+   for (uint64_t i = 0; i < length; ++i) {
+      hex[2 * i] = digits[bytes[i] >> 4];
+      hex[2 * i + 1] = digits[bytes[i] & 15];
+   }
+   hex[2 * length] = '\0';
