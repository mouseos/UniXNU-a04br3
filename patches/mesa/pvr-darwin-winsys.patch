+/*
+ * Darwin kernel interface of the PowerVR winsys: the requests of winsys/powervr travel to the NativePowerVR IOKit
+ * user client (NativePowerVRABI.h, version 1) instead of the Linux DRM device. Modelled on Turnip's darwin backend
+ * (tu_knl_darwin.cc): no libdrm, fences returned by the submission and waited for through the user client.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef PVR_DARWIN_H
+#define PVR_DARWIN_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <vulkan/vulkan.h>
+
+#include "drm-uapi/pvr_drm.h"
+
+struct pvr_winsys;
+struct vk_sync;
+struct vk_sync_signal;
+struct vk_sync_wait;
+
+/* The connection is the winsys's render_fd (the io_connect_t, a Mach port name). */
+VkResult pvr_darwin_open(int *const fd_out);
+void pvr_darwin_close(int fd);
+
+/* Already formatted, bounded SIPF1 snapshot line; callers cap stream count. */
+#ifdef PVR_WINSYS_DARWIN
+void pvr_darwin_sipf1_log(const char *text);
+#else
+static inline void pvr_darwin_sipf1_log(const char *text) { (void)text; }
+#endif
+
+/* Opt-in, bounded console trace for owner probe geometry diagnostics. */
+void pvr_darwin_debug(const char *format, ...) __attribute__((format(printf, 1, 2)));
+
+/* Declared in pvr_winsys_helper.h, which routes pvr_ioctl() here: 0, or -1 with errno set. */
+int pvr_darwin_ioctl(int fd, unsigned long request, void *arg);
+
+/* Maps the whole BO; "token" is the offset that DRM_IOCTL_PVR_GET_BO_MMAP_OFFSET returned (the memory type). */
+VkResult pvr_darwin_bo_map(int fd, void *addr, uint64_t size, uint64_t token, void **const map_out);
+VkResult pvr_darwin_bo_unmap(int fd, uint64_t token, void *map, uint64_t size, bool reserve);
+
+/* VK_EXT_external_memory_host: whether the connection's kernel imports pages of this task (NativePowerVRMethodImportHostMemory),
+ * and the import itself: a BO handle over [pointer, pointer + size), both 4 KiB aligned. */
+bool pvr_darwin_has_host_import(int fd);
+VkResult pvr_darwin_import_host(int fd, void *pointer, uint64_t size, uint32_t *const handle_out);
+
+void pvr_darwin_init_sync_types(struct pvr_winsys *ws);
+
+/* A sync that resolves to the fence of jobs.array[job]. A NULL sync is skipped. */
+struct pvr_darwin_signal {
+   struct vk_sync *sync;
+   uint32_t job;
+};
+
+/* Waits for "waits" on the CPU (NULL entries are skipped), submits and resolves "signals". */
+VkResult pvr_darwin_submit_jobs(int fd,
+                                const struct drm_pvr_ioctl_submit_jobs_args *args,
+                                struct vk_sync *const *waits,
+                                uint32_t wait_count,
+                                const struct pvr_darwin_signal *signals,
+                                uint32_t signal_count,
+                                const char *what);
+
+VkResult pvr_darwin_null_job_submit(struct vk_sync_wait *waits,
+                                    uint32_t wait_count,
+                                    struct vk_sync_signal *signal_sync);
+
+#endif /* PVR_DARWIN_H */
