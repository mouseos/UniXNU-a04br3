+   result = pvr_drm_winsys_buffer_create(ws, page, page,
+                                        PVR_WINSYS_BO_TYPE_GPU, 0, &guard_bo);
+   if (result != VK_SUCCESS)
+      return result;
+
+   result = pvr_drm_winsys_vma_map(vma, bo, offset, size, &dev_addr);
+   if (result != VK_SUCCESS)
+      goto out_destroy_guard;
+
+   drm_vma->guard = (struct pvr_winsys_vma){
+      .heap = vma->heap,
+      .dev_addr = PVR_DEV_ADDR_OFFSET(vma->dev_addr, payload_size),
+      .size = page,
+   };
+   result = pvr_drm_winsys_vma_map(&drm_vma->guard, guard_bo, 0, page, NULL);
+   if (result != VK_SUCCESS) {
+      pvr_drm_vma_unmap_one(vma);
+      goto out_destroy_guard;
+   }
+
+   if (dev_addr_out)
+      *dev_addr_out = dev_addr;
+
+out_destroy_guard:
+   /* Each successful map owns a reference; discard the creation reference. */
+   pvr_drm_winsys_buffer_destroy(guard_bo);
+   return result;
+}
+
+void pvr_drm_winsys_vma_unmap(struct pvr_winsys_vma *vma)
+{
+   struct pvr_drm_winsys_vma *drm_vma = to_pvr_drm_winsys_vma(vma);
+
+   /* Darwin requires one exact unmap per mapping, including during rollback. */
+   if (drm_vma->guard.bo)
+      pvr_drm_vma_unmap_one(&drm_vma->guard);
+   pvr_drm_vma_unmap_one(vma);
+}
