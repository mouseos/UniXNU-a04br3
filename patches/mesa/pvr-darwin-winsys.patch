+static bool
+pvr_darwin_copy_buffer_rows(struct pvr_cmd_buffer *cmd_buffer,
+                           const struct pvr_buffer *src,
+                           const struct pvr_buffer *dst,
+                           const VkCopyBufferInfo2 *info)
+{
+   const char *enabled = getenv("PVR_DARWIN_BUFFER_ROWS");
+   if (!enabled || strcmp(enabled, "1") || info->regionCount < 2 ||
+       info->regionCount > PVR_MAX_TRANSFER_SIZE_IN_TEXELS || src == dst)
+      return false;
+
+   const VkBufferCopy2 *rows = info->pRegions;
+   const uint64_t bytes = rows[0].size;
+   if (!bytes || bytes % 16 || bytes / 16 > PVR_MAX_TRANSFER_SIZE_IN_TEXELS ||
+       rows[1].srcOffset <= rows[0].srcOffset ||
