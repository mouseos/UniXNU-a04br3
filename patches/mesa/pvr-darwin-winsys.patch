+#include "vk_log.h"
+#include "vk_sync.h"
+#include "vk_sync_timeline.h"
+
+/* Existing Metal marker ABI: Unsupported is expected after kernel delivery.
+ * No /dev/console open, GPU memory access, or new kernel interface.
+ */
+void pvr_darwin_sipf1_log(const char *text)
+{
+   static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+   static unsigned sequence;
+   const char *flag = getenv("PVR_DARWIN_SIPF1_DUMP");
+   if (!text || !flag || strcmp(flag, "1")) return;
+   const char *stderr_only = getenv("PVR_DARWIN_SIPF1_STDERR_ONLY");
+   if (stderr_only && strcmp(stderr_only, "1") == 0) return;
+   const size_t length = strnlen(text, 255);
+   if (!length) return;
+   pthread_mutex_lock(&lock);
+   const char *name = getenv("PVR_DARWIN_SERVICE");
+   if (!name || !*name) name = NativePowerVRServiceName;
+   CFMutableDictionaryRef matching = IOServiceMatching(name);
+   io_service_t service = matching ? IOServiceGetMatchingService(kIOMainPortDefault, matching) : 0;
+   if (service) {
+      const unsigned id = sequence++;
+      const unsigned parts = (length + 39) / 40;
+      for (unsigned part = 0; part < parts; ++part) {
+         char chunk[64];
+         const unsigned at = part * 40;
+         const unsigned count = length - at < 40 ? length - at : 40;
+         int prefix = snprintf(chunk, sizeof(chunk), "S1 %08x.%u/%u ", id, part + 1, parts);
+         if (prefix < 0 || (size_t)prefix + count >= sizeof(chunk)) break;
+         for (unsigned i = 0; i < count; ++i) {
+            unsigned char c = text[at + i];
+            chunk[prefix + i] = c >= 0x20 && c < 0x7f ? c : '?';
+         }
+         const unsigned size = prefix + count;
+         chunk[size] = 0;
+         for (unsigned i = 0; i < size + 2; ++i) {
+            const uint32_t value = !i ? 0x7fff : i == size + 1 ? 0x7ffd : 0x7000 | (unsigned char)chunk[i - 1];
+            io_connect_t conn = 0;
+            kern_return_t kr = IOServiceOpen(service, mach_task_self(), NativePowerVRMetalMarkBase | value, &conn);
+            if (kr == KERN_SUCCESS && conn) IOServiceClose(conn);
+         }
+      }
+      IOObjectRelease(service);
+   }
+   pthread_mutex_unlock(&lock);
+}
+
+/* Deliberately off unless the owner probe requests it; at most 32 short lines. */
+void pvr_darwin_debug(const char *format, ...)
+{
+   if (!getenv("PVR_DARWIN_DEBUG_GEOMETRY"))
+      return;
+   static unsigned emitted;
+   if (__atomic_fetch_add(&emitted, 1, __ATOMIC_RELAXED) >= 32)
+      return;
+   char text[512];
+   int prefix = snprintf(text, sizeof(text), "pvr-darwin geometry: ");
+   va_list args;
+   va_start(args, format);
+   int count = vsnprintf(text + prefix, sizeof(text) - prefix - 1, format, args);
+   va_end(args);
+   if (count < 0)
+      return;
+   size_t size = MIN2((size_t)prefix + count, sizeof(text) - 2);
+   text[size++] = '\n';
+   int fd = open("/dev/console", O_WRONLY);
+   if (fd < 0)
+      return;
+   size_t at = 0;
+   while (at < size) {
+      ssize_t n = write(fd, text + at, size - at);
+      if (n < 0 && errno == EINTR)
+         continue;
+      if (n <= 0)
+         break;
+      at += n;
+   }
+   close(fd);
+}
+
+/* Process state shared by every connection: the tunnel selector of a sandboxed process and the lock and condition
+ * that resolve syncs. */
+static struct {
+   pthread_mutex_t lock;
+   pthread_cond_t resolved; /* broadcast whenever a sync gets its fences */
+   bool tunnel;
+   bool probed;
+   uint32_t selector;
+   uint32_t max_jobs;
+} pvr_dw = {
+   .lock = PTHREAD_MUTEX_INITIALIZER,
+   .resolved = PTHREAD_COND_INITIALIZER,
+};
+
+static inline io_connect_t pvr_darwin_conn(int fd)
+{
+   return (io_connect_t)(uint32_t)fd;
+}
+
+/* Largest method input: drm_pvr_ioctl_create_hwrt_dataset_args (136 bytes). */
+#define PVR_DARWIN_MAX_INPUT 256
+
+static kern_return_t pvr_darwin_call(int fd,
+                                     uint32_t method,
+                                     const void *in,
+                                     size_t in_size,
+                                     void *out,
+                                     size_t out_size)
+{
+   size_t out_bytes = out_size;
+
+   if (!pvr_dw.tunnel) {
+      return IOConnectCallStructMethod(pvr_darwin_conn(fd),
+                                       method,
+                                       in,
+                                       in_size,
+                                       out_size ? out : NULL,
+                                       out_size ? &out_bytes : NULL);
+   }
+
+   uint8_t buffer[8 + PVR_DARWIN_MAX_INPUT];
+   const uint32_t header[2] = { NativePowerVRTunnelMagic, method };
+
+   if (in_size > PVR_DARWIN_MAX_INPUT)
+      return kIOReturnBadArgument;
+
+   memcpy(buffer, header, sizeof(header));
+   if (in_size)
+      memcpy(buffer + sizeof(header), in, in_size);
+
+   return IOConnectCallStructMethod(pvr_darwin_conn(fd),
+                                    pvr_dw.selector,
+                                    buffer,
+                                    sizeof(header) + in_size,
+                                    out_size ? out : NULL,
+                                    out_size ? &out_bytes : NULL);
+}
+
+/* A sandboxed process reaches the driver through one admitted selector (NativeAdreno's tunnel). */
+static bool pvr_darwin_probe_selector(io_connect_t conn)
+{
+   const uint32_t header[2] = { NativePowerVRTunnelMagic,
+                                NativePowerVRTunnelProbe };
+
+   for (uint32_t s = 0; s < 256; s++) {
+      if (IOConnectCallStructMethod(conn, s, header, sizeof(header), NULL, NULL) ==
+          KERN_SUCCESS) {
+         pvr_dw.selector = s;
+         return true;
+      }
+   }
+
+   return false;
+}
+
+VkResult pvr_darwin_open(int *const fd_out)
+{
+   /* PVR_DARWIN_SERVICE names the IOKit service (default: the direct user client) and PVR_DARWIN_OPEN_TYPE its
+    * open type; any other service than the direct one is reached through the tunnel. */
+   const char *service_name = getenv("PVR_DARWIN_SERVICE");
+   const char *type_text = getenv("PVR_DARWIN_OPEN_TYPE");
+   struct NativePowerVRAbiParams params = { 0 };
+   io_service_t service;
+   io_connect_t conn = 0;
+   uint32_t open_type;
+   kern_return_t kr;
+   bool direct;
+
+   if (!service_name || !*service_name)
+      service_name = NativePowerVRServiceName;
+   direct = !strcmp(service_name, NativePowerVRServiceName);
+   open_type = type_text && *type_text ? (uint32_t)strtoul(type_text, NULL, 0) : 0;
+
+   service = IOServiceGetMatchingService(kIOMainPortDefault,
+                                         IOServiceMatching(service_name));
+   if (!service)
+      return VK_ERROR_INCOMPATIBLE_DRIVER;
+
+   kr = IOServiceOpen(service, mach_task_self(), open_type, &conn);
+   IOObjectRelease(service);
+   if (kr != KERN_SUCCESS) {
+      return vk_errorf(NULL,
+                       VK_ERROR_INITIALIZATION_FAILED,
+                       "IOServiceOpen(%s, 0x%x) failed: 0x%x",
+                       service_name,
+                       open_type,
+                       kr);
+   }
+
+   pthread_mutex_lock(&pvr_dw.lock);
+   if (!pvr_dw.probed) {
+      pvr_dw.tunnel = !direct;
+      if (pvr_dw.tunnel && !pvr_darwin_probe_selector(conn)) {
+         pthread_mutex_unlock(&pvr_dw.lock);
+         IOServiceClose(conn);
+         return vk_errorf(NULL,
+                          VK_ERROR_INITIALIZATION_FAILED,
+                          "No external-method selector is admitted for this process");
+      }
+      pvr_dw.probed = true;
+   }
+   pthread_mutex_unlock(&pvr_dw.lock);
+
+   kr = pvr_darwin_call((int)conn,
+                        NativePowerVRMethodGetParams,
+                        NULL,
+                        0,
+                        &params,
+                        sizeof(params));
+   if (kr != KERN_SUCCESS || params.abi_version != NativePowerVRAbiVersion ||
+       params.max_jobs == 0) {
+      IOServiceClose(conn);
+      return vk_errorf(NULL,
+                       VK_ERROR_INCOMPATIBLE_DRIVER,
+                       "NativePowerVR ABI query failed: 0x%x, version %u",
+                       kr,
+                       params.abi_version);
+   }
+
+   pthread_mutex_lock(&pvr_dw.lock);
+   pvr_dw.max_jobs = MIN2(params.max_jobs, NativePowerVRAbiMaxJobs);
+   pthread_mutex_unlock(&pvr_dw.lock);
+
+   *fd_out = (int)conn;
+
+   return VK_SUCCESS;
+}
+
+void pvr_darwin_close(int fd)
+{
+   IOServiceClose(pvr_darwin_conn(fd));
+}
+
+static int pvr_darwin_errno(kern_return_t kr)
+{
+   switch (kr) {
+   case kIOReturnBadArgument:
+      return EINVAL;
+   case kIOReturnNoMemory:
+   case kIOReturnNoResources:
+      return ENOMEM;
+   case kIOReturnUnsupported:
+      return ENOTTY;
+   case kIOReturnNotPermitted:
+      return EPERM;
+   case kIOReturnBusy:
+      return EBUSY;
+   case kIOReturnTimeout:
+      return ETIMEDOUT;
+   default:
+      return EIO;
+   }
+}
+
+int pvr_darwin_ioctl(int fd, unsigned long request, void *arg)
+{
+   uint32_t method;
+   size_t size;
+   bool out;
+
+   switch (request) {
+#define PVR_DARWIN_REQUEST(_request, _method, _type, _out) \
+   case _request:                                          \
+      method = _method;                                    \
+      size = sizeof(_type);                                \
+      out = _out;                                          \
+      break
+
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_DEV_QUERY,
+                         NativePowerVRMethodDevQuery,
+                         struct drm_pvr_ioctl_dev_query_args,
+                         true);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_CREATE_BO,
+                         NativePowerVRMethodCreateBo,
+                         struct drm_pvr_ioctl_create_bo_args,
+                         true);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_GET_BO_MMAP_OFFSET,
+                         NativePowerVRMethodGetBoMmapOffset,
+                         struct drm_pvr_ioctl_get_bo_mmap_offset_args,
+                         true);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_CREATE_VM_CONTEXT,
+                         NativePowerVRMethodCreateVmContext,
+                         struct drm_pvr_ioctl_create_vm_context_args,
+                         true);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_DESTROY_VM_CONTEXT,
+                         NativePowerVRMethodDestroyVmContext,
+                         struct drm_pvr_ioctl_destroy_vm_context_args,
+                         false);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_VM_MAP,
+                         NativePowerVRMethodVmMap,
+                         struct drm_pvr_ioctl_vm_map_args,
+                         false);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_VM_UNMAP,
+                         NativePowerVRMethodVmUnmap,
+                         struct drm_pvr_ioctl_vm_unmap_args,
+                         false);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_CREATE_CONTEXT,
+                         NativePowerVRMethodCreateContext,
+                         struct drm_pvr_ioctl_create_context_args,
+                         true);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_DESTROY_CONTEXT,
+                         NativePowerVRMethodDestroyContext,
+                         struct drm_pvr_ioctl_destroy_context_args,
+                         false);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_CREATE_FREE_LIST,
+                         NativePowerVRMethodCreateFreeList,
+                         struct drm_pvr_ioctl_create_free_list_args,
+                         true);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_DESTROY_FREE_LIST,
+                         NativePowerVRMethodDestroyFreeList,
+                         struct drm_pvr_ioctl_destroy_free_list_args,
+                         false);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_CREATE_HWRT_DATASET,
+                         NativePowerVRMethodCreateHwrtDataset,
+                         struct drm_pvr_ioctl_create_hwrt_dataset_args,
+                         true);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_PVR_DESTROY_HWRT_DATASET,
+                         NativePowerVRMethodDestroyHwrtDataset,
+                         struct drm_pvr_ioctl_destroy_hwrt_dataset_args,
+                         false);
+      PVR_DARWIN_REQUEST(DRM_IOCTL_GEM_CLOSE,
+                         NativePowerVRMethodGemClose,
+                         struct drm_gem_close,
+                         false);
+
+#undef PVR_DARWIN_REQUEST
+
+   default:
+      /* DRM_IOCTL_PVR_SUBMIT_JOBS goes through pvr_darwin_submit_jobs(), which keeps the fences. */
+      errno = ENOTTY;
+      return -1;
+   }
+
+   const kern_return_t kr =
+      pvr_darwin_call(fd, method, arg, size, out ? arg : NULL, out ? size : 0);
+   if (kr != KERN_SUCCESS) {
+      errno = pvr_darwin_errno(kr);
+      return -1;
+   }
+
+   return 0;
+}
+
+VkResult pvr_darwin_bo_map(int fd,
+                           void *addr,
+                           uint64_t size,
+                           uint64_t token,
+                           void **const map_out)
+{
+   mach_vm_address_t address = 0;
+   mach_vm_size_t mapped = 0;
+   kern_return_t kr;
+
+   /* The user client offers no mapping at a caller-chosen address (VK_EXT_map_memory_placed is not exposed). */
+   if (addr || token > UINT32_MAX)
+      return vk_error(NULL, VK_ERROR_MEMORY_MAP_FAILED);
+
+   kr = IOConnectMapMemory64(pvr_darwin_conn(fd),
+                             (uint32_t)token,
+                             mach_task_self(),
+                             &address,
+                             &mapped,
+                             /* XNU's default-cache descriptor fallback records the
+                              * unshifted cache enum in low map flags (observed 0x5,
+                              * WB PTE). Request the ABI's WC mode explicitly. */
+                             kIOMapAnywhere | kIOMapWriteCombineCache);
+   if (kr != KERN_SUCCESS) {
+      return vk_errorf(NULL,
+                       VK_ERROR_MEMORY_MAP_FAILED,
+                       "IOConnectMapMemory64 failed: 0x%x",
+                       kr);
+   }
+
+   if (mapped < size) {
+      IOConnectUnmapMemory64(pvr_darwin_conn(fd),
+                             (uint32_t)token,
+                             mach_task_self(),
+                             address);
+      return vk_errorf(NULL,
+                       VK_ERROR_MEMORY_MAP_FAILED,
+                       "BO mapping covers 0x%llx of 0x%llx bytes",
+                       (unsigned long long)mapped,
+                       (unsigned long long)size);
+   }
+
+   *map_out = (void *)(uintptr_t)address;
+
+   return VK_SUCCESS;
+}
+
+VkResult pvr_darwin_bo_unmap(int fd,
+                             uint64_t token,
+                             void *map,
+                             uint64_t size,
+                             bool reserve)
+{
+   const kern_return_t kr =
+      IOConnectUnmapMemory64(pvr_darwin_conn(fd),
+                             (uint32_t)token,
+                             mach_task_self(),
+                             (mach_vm_address_t)(uintptr_t)map);
+   if (kr != KERN_SUCCESS)
+      return vk_errorf(NULL, VK_ERROR_UNKNOWN, "IOConnectUnmapMemory64 failed: 0x%x", kr);
+
+   /* As pvr_munmap(): keep the range reserved. */
+   if (reserve &&
+       mmap(map, size, PROT_NONE, MAP_FIXED | MAP_PRIVATE | MAP_ANON, -1, 0) ==
+          MAP_FAILED) {
+      return vk_errorf(NULL, VK_ERROR_UNKNOWN, "mmap(reserve) failed (errno %d)", errno);
+   }
+
+   return VK_SUCCESS;
+}
+
+bool pvr_darwin_has_host_import(int fd)
+{
+   /* A kernel that knows the method refuses a call without its input (kIOReturnBadArgument); an older one does not know it
+    * (kIOReturnUnsupported). Nothing is imported. */
+   return pvr_darwin_call(fd, NativePowerVRMethodImportHostMemory, NULL, 0, NULL, 0) == kIOReturnBadArgument;
+}
+
+VkResult pvr_darwin_import_host(int fd, void *pointer, uint64_t size, uint32_t *const handle_out)
+{
+   struct NativePowerVRAbiImportHost args = {
+      .address = (uint64_t)(uintptr_t)pointer,
+      .size = size,
+   };
+   kern_return_t kr;
+
+   if (!pointer || !size || ((args.address | size) & 4095))
+      return vk_error(NULL, VK_ERROR_INVALID_EXTERNAL_HANDLE);
+
+   kr = pvr_darwin_call(fd, NativePowerVRMethodImportHostMemory, &args, sizeof(args), &args, sizeof(args));
+   if (kr != KERN_SUCCESS || !args.handle) {
+      return vk_errorf(NULL,
+                       kr == kIOReturnNoMemory || kr == kIOReturnNoResources ? VK_ERROR_OUT_OF_HOST_MEMORY
+                                                                             : VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "NativePowerVR host import of 0x%llx bytes at %p failed: 0x%x",
+                       (unsigned long long)size,
+                       pointer,
+                       kr);
+   }
+
+   *handle_out = args.handle;
+
+   return VK_SUCCESS;
+}
+
+/* ---- synchronization ----
+ *
+ * A sync is unsignaled until a submission resolves it; then it is complete once all of its fences are (none:
+ * signaled). Fences carry their connection, because the physical device and every logical device have their own. */
+
+#define PVR_DARWIN_SYNC_FENCES 8
+
+struct pvr_darwin_fence {
+   int fd;
+   uint64_t value;
+};
+
+struct pvr_darwin_sync {
+   struct vk_sync base;
+   bool resolved;
+   uint32_t count;
+   struct pvr_darwin_fence fences[PVR_DARWIN_SYNC_FENCES];
+};
+
+static inline struct pvr_darwin_sync *to_pvr_darwin_sync(struct vk_sync *sync)
+{
+   return container_of(sync, struct pvr_darwin_sync, base);
+}
+
+/* Absolute monotonic deadline -> absolute realtime one for pthread_cond_timedwait() (Darwin has no
+ * pthread_condattr_setclock). */
+static struct timespec pvr_darwin_realtime_deadline(uint64_t abs_timeout_ns)
+{
+   const uint64_t now = os_time_get_nano();
+   const uint64_t relative = abs_timeout_ns > now ? abs_timeout_ns - now : 0;
+   struct timespec abstime;
+   uint64_t nsec;
+
+   clock_gettime(CLOCK_REALTIME, &abstime);
+   nsec = (uint64_t)abstime.tv_nsec + relative % 1000000000ull;
+   abstime.tv_sec += relative / 1000000000ull + nsec / 1000000000ull;
+   abstime.tv_nsec = nsec % 1000000000ull;
+
+   return abstime;
+}
+
+/* Waits under pvr_dw.lock until "sync" is resolved. */
+static VkResult pvr_darwin_wait_resolved_locked(struct pvr_darwin_sync *sync,
+                                                uint64_t abs_timeout_ns)
+{
+   if (sync->resolved)
+      return VK_SUCCESS;
+   if (abs_timeout_ns == 0)
+      return VK_TIMEOUT;
+
+   const struct timespec abstime = pvr_darwin_realtime_deadline(abs_timeout_ns);
+
+   while (!sync->resolved) {
+      const int ret =
+         abs_timeout_ns == UINT64_MAX
+            ? pthread_cond_wait(&pvr_dw.resolved, &pvr_dw.lock)
+            : pthread_cond_timedwait(&pvr_dw.resolved, &pvr_dw.lock, &abstime);
+      if (ret == ETIMEDOUT)
+         return sync->resolved ? VK_SUCCESS : VK_TIMEOUT;
+      if (ret)
+         return vk_errorf(NULL, VK_ERROR_DEVICE_LOST, "pthread_cond_wait failed: %d", ret);
+   }
+
+   return VK_SUCCESS;
+}
+
+/* NativePowerVRMethodWaitFence in slices, so a deadline is honoured without one long kernel wait. */
+static VkResult pvr_darwin_wait_fence(const struct pvr_darwin_fence *fence,
+                                      uint64_t abs_timeout_ns)
+{
+   for (;;) {
+      const uint64_t now = os_time_get_nano();
+      uint64_t slice = 100000000ull; /* 100 ms */
+
+      if (abs_timeout_ns != UINT64_MAX)
+         slice = abs_timeout_ns > now ? MIN2(slice, abs_timeout_ns - now) : 0;
+
+      const struct NativePowerVRAbiWaitFence req = {
+         .fence = fence->value,
+         .timeout_ns = slice,
+      };
+      const kern_return_t kr = pvr_darwin_call(fence->fd,
+                                               NativePowerVRMethodWaitFence,
+                                               &req,
+                                               sizeof(req),
+                                               NULL,
+                                               0);
+      if (kr == KERN_SUCCESS)
+         return VK_SUCCESS;
+      if (kr != kIOReturnTimeout) {
+         return vk_errorf(NULL,
+                          VK_ERROR_DEVICE_LOST,
+                          "NativePowerVR fence %llu failed: 0x%x",
+                          (unsigned long long)fence->value,
+                          kr);
+      }
+      if (slice == 0)
+         return VK_TIMEOUT;
+   }
+}
+
+/* Copies the fences of a resolved sync, waiting first for its resolution. */
+static VkResult pvr_darwin_sync_snapshot(struct pvr_darwin_sync *sync,
+                                         uint64_t abs_timeout_ns,
+                                         struct pvr_darwin_fence *fences,
+                                         uint32_t *const count_out)
+{
+   pthread_mutex_lock(&pvr_dw.lock);
+   const VkResult result = pvr_darwin_wait_resolved_locked(sync, abs_timeout_ns);
+   if (result == VK_SUCCESS) {
+      *count_out = sync->count;
+      memcpy(fences, sync->fences, sizeof(sync->fences[0]) * sync->count);
+   }
+   pthread_mutex_unlock(&pvr_dw.lock);
+
+   return result;
+}
+
+static VkResult pvr_darwin_sync_wait_one(struct pvr_darwin_sync *sync,
+                                         uint64_t abs_timeout_ns)
+{
+   struct pvr_darwin_fence fences[PVR_DARWIN_SYNC_FENCES];
+   uint32_t count = 0;
+   VkResult result;
+
+   result = pvr_darwin_sync_snapshot(sync, abs_timeout_ns, fences, &count);
+   if (result != VK_SUCCESS)
+      return result;
+
+   for (uint32_t i = 0; i < count; i++) {
+      result = pvr_darwin_wait_fence(&fences[i], abs_timeout_ns);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   return VK_SUCCESS;
+}
+
+static VkResult pvr_darwin_sync_poll_resolved(struct pvr_darwin_sync *sync)
+{
+   pthread_mutex_lock(&pvr_dw.lock);
+   const bool resolved = sync->resolved;
+   pthread_mutex_unlock(&pvr_dw.lock);
+
+   return resolved ? VK_SUCCESS : VK_TIMEOUT;
+}
+
+static VkResult pvr_darwin_sync_init(struct vk_device *device,
+                                     struct vk_sync *vk_sync,
+                                     uint64_t initial_value)
+{
+   struct pvr_darwin_sync *sync = to_pvr_darwin_sync(vk_sync);
+
+   sync->resolved = initial_value != 0;
+   sync->count = 0;
+
+   return VK_SUCCESS;
+}
+
+static void pvr_darwin_sync_finish(struct vk_device *device,
+                                   struct vk_sync *vk_sync)
+{
+}
+
+static VkResult pvr_darwin_sync_signal(struct vk_device *device,
+                                       struct vk_sync *vk_sync,
+                                       uint64_t value)
+{
+   struct pvr_darwin_sync *sync = to_pvr_darwin_sync(vk_sync);
+
+   pthread_mutex_lock(&pvr_dw.lock);
+   sync->resolved = true;
+   sync->count = 0;
+   pthread_cond_broadcast(&pvr_dw.resolved);
+   pthread_mutex_unlock(&pvr_dw.lock);
+
+   return VK_SUCCESS;
+}
+
+static VkResult pvr_darwin_sync_reset(struct vk_device *device,
+                                      struct vk_sync *vk_sync)
+{
+   struct pvr_darwin_sync *sync = to_pvr_darwin_sync(vk_sync);
+
+   pthread_mutex_lock(&pvr_dw.lock);
+   sync->resolved = false;
+   sync->count = 0;
+   pthread_mutex_unlock(&pvr_dw.lock);
+
+   return VK_SUCCESS;
+}
+
+static VkResult pvr_darwin_sync_move(struct vk_device *device,
+                                     struct vk_sync *vk_dst,
+                                     struct vk_sync *vk_src)
+{
+   struct pvr_darwin_sync *dst = to_pvr_darwin_sync(vk_dst);
+   struct pvr_darwin_sync *src = to_pvr_darwin_sync(vk_src);
+
+   pthread_mutex_lock(&pvr_dw.lock);
+   dst->resolved = src->resolved;
+   dst->count = src->count;
+   memcpy(dst->fences, src->fences, sizeof(src->fences[0]) * src->count);
+   src->resolved = false;
+   src->count = 0;
+   if (dst->resolved)
+      pthread_cond_broadcast(&pvr_dw.resolved);
+   pthread_mutex_unlock(&pvr_dw.lock);
+
+   return VK_SUCCESS;
+}
+
+static VkResult pvr_darwin_sync_wait_many(struct vk_device *device,
+                                          uint32_t wait_count,
+                                          const struct vk_sync_wait *waits,
+                                          enum vk_sync_wait_flags wait_flags,
+                                          uint64_t abs_timeout_ns)
+{
+   if (wait_flags & VK_SYNC_WAIT_ANY) {
+      for (;;) {
+         for (uint32_t i = 0; i < wait_count; i++) {
+            struct pvr_darwin_sync *sync = to_pvr_darwin_sync(waits[i].sync);
+            const VkResult result = (wait_flags & VK_SYNC_WAIT_PENDING)
+                                       ? pvr_darwin_sync_poll_resolved(sync)
+                                       : pvr_darwin_sync_wait_one(sync, 0);
+            if (result != VK_TIMEOUT)
+               return result;
+         }
+
+         if (abs_timeout_ns != UINT64_MAX && os_time_get_nano() >= abs_timeout_ns)
+            return VK_TIMEOUT;
+
+         usleep(200);
+      }
+   }
+
+   for (uint32_t i = 0; i < wait_count; i++) {
+      struct pvr_darwin_sync *sync = to_pvr_darwin_sync(waits[i].sync);
+      VkResult result;
+
+      if (wait_flags & VK_SYNC_WAIT_PENDING) {
+         pthread_mutex_lock(&pvr_dw.lock);
+         result = pvr_darwin_wait_resolved_locked(sync, abs_timeout_ns);
+         pthread_mutex_unlock(&pvr_dw.lock);
+      } else {
+         result = pvr_darwin_sync_wait_one(sync, abs_timeout_ns);
+      }
+
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   return VK_SUCCESS;
+}
+
+static const struct vk_sync_type pvr_darwin_sync_type = {
+   .size = sizeof(struct pvr_darwin_sync),
+   .features = VK_SYNC_FEATURE_BINARY | VK_SYNC_FEATURE_GPU_WAIT |
+               VK_SYNC_FEATURE_GPU_MULTI_WAIT | VK_SYNC_FEATURE_CPU_WAIT |
+               VK_SYNC_FEATURE_CPU_RESET | VK_SYNC_FEATURE_CPU_SIGNAL |
+               VK_SYNC_FEATURE_WAIT_ANY | VK_SYNC_FEATURE_WAIT_PENDING,
+   .init = pvr_darwin_sync_init,
+   .finish = pvr_darwin_sync_finish,
+   .signal = pvr_darwin_sync_signal,
+   .reset = pvr_darwin_sync_reset,
+   .move = pvr_darwin_sync_move,
+   .wait_many = pvr_darwin_sync_wait_many,
+};
+
+void pvr_darwin_init_sync_types(struct pvr_winsys *ws)
+{
+   /* Binary syncs, and timelines emulated on top of them, as the pvrsrvkm winsys does. */
+   ws->syncobj_type = pvr_darwin_sync_type;
+   ws->sync_types[0] = &ws->syncobj_type;
+   ws->timeline_syncobj_type = vk_sync_timeline_get_type(&ws->syncobj_type);
+   ws->sync_types[1] = &ws->timeline_syncobj_type.sync;
+   ws->sync_types[2] = NULL;
+}
+
+/* Explicit diagnostic comparison only; no reads, logging or cache maintenance. */
+static void pvr_darwin_submit_barrier(void)
+{
+#if defined(__aarch64__) || defined(__arm64__)
+   const char *flag = getenv("PVR_DARWIN_SUBMIT_BARRIER");
+   if (flag && strcmp(flag, "1") == 0)
+      __asm__ volatile("dsb sy" ::: "memory");
+#endif
+}
+
+VkResult pvr_darwin_submit_jobs(int fd,
+                                const struct drm_pvr_ioctl_submit_jobs_args *args,
+                                struct vk_sync *const *waits,
+                                uint32_t wait_count,
+                                const struct pvr_darwin_signal *signals,
+                                uint32_t signal_count,
+                                const char *what)
+{
+   struct NativePowerVRAbiSubmitReply reply = { 0 };
+   kern_return_t kr;
+
+   /* No kernel sync objects in version 1: the dependencies complete before the submission. */
+   for (uint32_t i = 0; i < wait_count; i++) {
+      if (!waits[i])
+         continue;
+
+      assert(!(waits[i]->flags & VK_SYNC_IS_TIMELINE));
+      const VkResult result =
+         pvr_darwin_sync_wait_one(to_pvr_darwin_sync(waits[i]), UINT64_MAX);
+      if (result != VK_SUCCESS) {
+         return vk_errorf(NULL,
+                          VK_ERROR_DEVICE_LOST,
+                          "Wait before the %s job failed",
+                          what);
+      }
+   }
+
+   if (args->jobs.count == 0 || args->jobs.count > pvr_dw.max_jobs ||
+       args->jobs.stride != sizeof(struct drm_pvr_job)) {
+      return vk_errorf(NULL,
+                       VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "Unsupported %s submission: %u jobs",
+                       what,
+                       args->jobs.count);
+   }
+
+   pvr_darwin_submit_barrier();
+   kr = pvr_darwin_call(fd,
+                        NativePowerVRMethodSubmitJobs,
+                        args,
+                        sizeof(*args),
+                        &reply,
+                        sizeof(reply));
+   if (kr != KERN_SUCCESS) {
+      /* VK_ERROR_OUT_OF_DEVICE_MEMORY as the powervr winsys returns, to match pvrsrv. */
+      return vk_errorf(NULL,
+                       VK_ERROR_OUT_OF_DEVICE_MEMORY,
+                       "Failed to submit %s job: 0x%x",
+                       what,
+                       kr);
+   }
+
+   /* Diagnostic only: isolate overlap between transfer kicks. Never wait under lock. */
+   const char *serial_transfer = getenv("PVR_DARWIN_SERIAL_TRANSFER");
+   if (what && !strcmp(what, "transfer") && serial_transfer &&
+       !strcmp(serial_transfer, "1")) {
+      const uint64_t now = os_time_get_nano();
+      const uint64_t duration = 10000000000ull;
+      /* UINT64_MAX means infinite to wait_fence, so saturate below it. */
+      const uint64_t deadline = now >= UINT64_MAX - duration
+                                  ? UINT64_MAX - 1 : now + duration;
+      for (uint32_t i = 0; i < args->jobs.count; i++) {
+         const struct pvr_darwin_fence fence = {
+            .fd = fd,
+            .value = reply.fence[i],
+         };
+         if (!fence.value || os_time_get_nano() >= deadline ||
+             pvr_darwin_wait_fence(&fence, deadline) != VK_SUCCESS) {
+            return vk_errorf(NULL, VK_ERROR_DEVICE_LOST,
+                             "Serial transfer fence wait failed");
+         }
+      }
+   }
+
+   pthread_mutex_lock(&pvr_dw.lock);
+   for (uint32_t i = 0; i < signal_count; i++) {
+      struct vk_sync *const vk_sync = signals[i].sync;
+
+      if (!vk_sync)
+         continue;
+
+      assert(!(vk_sync->flags & VK_SYNC_IS_TIMELINE));
+      assert(signals[i].job < args->jobs.count && reply.fence[signals[i].job]);
+
+      struct pvr_darwin_sync *sync = to_pvr_darwin_sync(vk_sync);
+      sync->fences[0] = (struct pvr_darwin_fence){
+         .fd = fd,
+         .value = reply.fence[signals[i].job],
+      };
+      sync->count = 1;
+      sync->resolved = true;
+   }
+   pthread_cond_broadcast(&pvr_dw.resolved);
+   pthread_mutex_unlock(&pvr_dw.lock);
+
+   return VK_SUCCESS;
+}
+
+/* The signal resolves to the union of the waits' fences; a wait that does not fit is waited for here. */
+VkResult pvr_darwin_null_job_submit(struct vk_sync_wait *waits,
+                                    uint32_t wait_count,
+                                    struct vk_sync_signal *signal_sync)
+{
+   struct pvr_darwin_fence fences[PVR_DARWIN_SYNC_FENCES];
+   uint32_t count = 0;
+
+   for (uint32_t i = 0; i < wait_count; i++) {
+      struct pvr_darwin_fence wait_fences[PVR_DARWIN_SYNC_FENCES];
+      uint32_t wait_fence_count = 0;
+      VkResult result;
+
+      if (!waits[i].sync)
+         continue;
+
+      assert(!(waits[i].sync->flags & VK_SYNC_IS_TIMELINE));
+      result = pvr_darwin_sync_snapshot(to_pvr_darwin_sync(waits[i].sync),
+                                        UINT64_MAX,
+                                        wait_fences,
+                                        &wait_fence_count);
+      if (result != VK_SUCCESS)
+         return result;
+
+      for (uint32_t j = 0; j < wait_fence_count; j++) {
+         if (count < ARRAY_SIZE(fences)) {
+            fences[count++] = wait_fences[j];
+            continue;
+         }
+
+         result = pvr_darwin_wait_fence(&wait_fences[j], UINT64_MAX);
+         if (result != VK_SUCCESS)
+            return result;
+      }
+   }
+
+   assert(!(signal_sync->sync->flags & VK_SYNC_IS_TIMELINE));
+
+   struct pvr_darwin_sync *sync = to_pvr_darwin_sync(signal_sync->sync);
+
+   pthread_mutex_lock(&pvr_dw.lock);
+   memcpy(sync->fences, fences, sizeof(fences[0]) * count);
+   sync->count = count;
+   sync->resolved = true;
+   pthread_cond_broadcast(&pvr_dw.resolved);
+   pthread_mutex_unlock(&pvr_dw.lock);
+
+   return VK_SUCCESS;
+}
